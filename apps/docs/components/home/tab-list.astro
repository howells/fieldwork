---
// The provider tabs of a code panel: a strip of buttons that shows one
// tabpanel at a time. Each panel's id is `${id}-panel-${index}`; put the
// panels beside this strip inside an element with data-provider-tabs, which
// receives a "tabchange" event after each selection.
interface Props {
  id: string;
  initial?: number;
  label: string;
  tabs: string[];
}

const { id, initial = 0, label, tabs } = Astro.props;
---

<div class="relative flex h-[52px] items-center overflow-x-auto border-b border-rule bg-wash px-2" role="tablist" aria-label={label}>
  <span aria-hidden="true" class="tab-indicator" data-tab-indicator></span>
  {tabs.map((tab, index) => (
    <button
      aria-controls={`${id}-panel-${index}`}
      aria-selected={index === initial ? "true" : "false"}
      class="type-small relative h-9 shrink-0 rounded-[6px] px-2.5 text-graphite transition-colors hover:text-ink aria-selected:bg-paper aria-selected:font-medium aria-selected:text-ink aria-selected:shadow-[0_0_0_1px_var(--color-rule)]"
      id={`${id}-tab-${index}`}
      role="tab"
      tabindex={index === initial ? 0 : -1}
      type="button"
    >{tab}</button>
  ))}
</div>

<script>
  const bind = () => {
    for (const root of document.querySelectorAll<HTMLElement>(
      "[data-provider-tabs]:not([data-bound])"
    )) {
      root.dataset.bound = "";
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const indicator = root.querySelector<HTMLElement>("[data-tab-indicator]");
      // The highlight slides to a clicked tab; it jumps for the keyboard and
      // on resize, where motion would only lag behind.
      const place = (animate: boolean) => {
        const current = tabs.find((tab) => tab.getAttribute("aria-selected") === "true");
        if (indicator === null || current === undefined) {
          return;
        }
        indicator.style.transitionDuration = animate ? "" : "0s";
        indicator.style.width = `${current.offsetWidth}px`;
        indicator.style.height = `${current.offsetHeight}px`;
        indicator.style.transform = `translate(${current.offsetLeft}px, ${current.offsetTop}px)`;
      };
      const select = (next: HTMLButtonElement, animate: boolean) => {
        for (const tab of tabs) {
          const selected = tab === next;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute("aria-controls") ?? ""}`);
          if (panel) {
            panel.hidden = !selected;
          }
        }
        place(animate);
        root.dispatchEvent(new Event("tabchange"));
      };
      const tablist = root.querySelector('[role="tablist"]');
      if (indicator !== null && tablist !== null) {
        new ResizeObserver(() => place(false)).observe(tablist);
        root.dataset.tabsReady = "";
      }
      for (const [index, tab] of tabs.entries()) {
        tab.addEventListener("click", (event) => select(tab, event.detail !== 0));
        tab.addEventListener("keydown", (event) => {
          const step = { ArrowLeft: -1, ArrowRight: 1 }[event.key];
          if (step === undefined) {
            return;
          }
          event.preventDefault();
          const next = tabs.at((index + step) % tabs.length);
          if (next) {
            select(next, false);
            next.focus();
          }
        });
      }
    }
  };

  bind();
  document.addEventListener("astro:page-load", bind);
</script>
