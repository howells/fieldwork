---
import { RESUME_SAMPLE } from "../../lib/samples";
import Panel from "./panel.astro";
---

<section class="border-t border-rule">
  <div class="home-wrap flex flex-col gap-10 py-16 md:py-[120px] lg:flex-row lg:items-center lg:justify-between lg:gap-16">
    <div class="flex flex-col gap-6 lg:w-[520px] lg:shrink-0">
      <h2 class="home-heading md:max-w-[460px]">Collect a long job after a timeout.</h2>
      <p class="home-lead">
        Research and crawls keep running on the provider after your wait ends, and keep costing money. The error carries the job's id. Pass it back as <code class="font-mono text-[0.9em] text-ink">resume</code> to collect the result instead of paying for a second job.
      </p>
      <a class="text-[14px] font-medium text-map-blue hover:underline" href="/docs/long-jobs">How long jobs work →</a>
    </div>
    <Panel caption="Exa" class="lg:w-[664px] lg:shrink" code={RESUME_SAMPLE} file="resume.ts" />
  </div>
</section>
