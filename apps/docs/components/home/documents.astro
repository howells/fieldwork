---
import { boxGeometry, CELLS, HEIGHT, IMAGES, MARKED_CELL, PAGE_RATIO, PARSER_BOXES, readouts, TEXT, WIDTH, x, y } from "../../lib/parse-figure";
import type { Box } from "../../lib/parse-figure";
import Code from "./code.astro";
import TabList from "./tab-list.astro";

/** A line of text drawn as a bar: the box split into lines, the last one shorter. */
const bars = (box: Box) => {
  const [left, top, width, height] = box;
  const lines = Math.max(1, Math.round(height / 0.0105));
  const step = height / lines;
  return Array.from({ length: lines }, (_, line) => ({
    height: y(step * 0.62),
    width: x(lines > 1 && line === lines - 1 ? width * 0.62 : width),
    x: x(left),
    y: y(top + step * line + step * 0.19),
  }));
};

// A rule between each row of the table, halfway between one row and the next.
const rowTops = [...new Set(CELLS.filter((_, index) => index % 4 === 0).map((cell) => cell[1]))];
const RULES = rowTops.slice(1).map((top, index) => {
  const previous = CELLS[index * 4];
  const bottom = previous === undefined ? top : previous[1] + previous[3];
  return y((Math.max(bottom, ...CELLS.slice(index * 4, index * 4 + 4).map((cell) => cell[1] + cell[3])) + top) / 2);
});
const TABLE = { left: x(0.313), right: x(0.684) };

// The figure first shows the first parser's box; the script moves it.
const [firstParser] = PARSER_BOXES;
if (firstParser === undefined) {
  throw new Error("the parse figure needs a parser");
}
const first = firstParser.box;
const start = boxGeometry(first, 1);
const [readLeft, readTop] = [readouts(first, 1).left, readouts(first, 1).top];
---

<section class="border-t border-rule bg-wash">
  <div class="home-wrap py-16 md:py-[120px]">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <h2 class="type-heading md:max-w-[560px]">Boxes line up across parsers.</h2>
      <p class="type-lead m-0 text-graphite lg:max-w-[460px]">
        Every box is a fraction of the page from its top-left corner. LlamaParse and Reducto place each word and table cell.
      </p>
    </div>

    <div class="hero-panel mt-10 min-w-0 overflow-clip rounded-[12px] border border-rule bg-paper md:mt-16" data-provider-tabs>
      <TabList id="parse" label="Parser" tabs={PARSER_BOXES.map((parser) => parser.label)} />
      <div class="grid lg:grid-cols-[minmax(0,1fr)_480px]">
        <figure
          aria-hidden="true"
          class="m-0 bg-wash p-4 sm:p-8 lg:p-12"
          data-parse-figure
        >
          <div class="relative rounded-[2px] bg-paper shadow-[0_0_0_1px_var(--color-rule),0_12px_32px_-16px_rgb(18_20_23/18%)] [contain:layout]" style={`aspect-ratio: ${PAGE_RATIO}`}>
            <svg class="absolute inset-0 size-full" viewBox={`0 0 ${WIDTH} ${HEIGHT}`}>
              {IMAGES.map(([l, t, w, h]) => (
                <rect fill="#ECEDEA" height={y(h)} rx="2" width={x(w)} x={x(l)} y={y(t)} />
              ))}
              {TEXT.flatMap((box) => bars(box)).map((bar) => (
                <rect fill="#D6D8D3" height={bar.height} rx={bar.height / 2} width={bar.width} x={bar.x} y={bar.y} />
              ))}
              {RULES.map((ruleY) => (
                <line stroke="var(--color-rule)" stroke-width="1" vector-effect="non-scaling-stroke" x1={TABLE.left} x2={TABLE.right} y1={ruleY} y2={ruleY} />
              ))}
              {CELLS.map((cell, cellIndex) => bars(cell).map((bar) => (
                <rect
                  fill={cellIndex === MARKED_CELL ? "var(--color-ink)" : cellIndex % 2 === 0 ? "#C6C9C3" : "#DCDED9"}
                  height={bar.height}
                  rx={bar.height / 2}
                  width={bar.width}
                  x={bar.x}
                  y={bar.y}
                />
              )))}
              <g stroke="var(--color-map-blue)" stroke-dasharray="3 4" stroke-width="1">
                <line data-guide="left" vector-effect="non-scaling-stroke" x1="0" x2={start.guideLeft.x2} y1={start.guideLeft.y1} y2={start.guideLeft.y2} />
                <line data-guide="top" vector-effect="non-scaling-stroke" x1={start.guideTop.x1} x2={start.guideTop.x2} y1="0" y2={start.guideTop.y2} />
              </g>
              <rect
                class="parse-box"
                data-box
                fill="rgb(31 63 209 / 10%)"
                height={start.box.height}
                stroke="var(--color-map-blue)"
                stroke-width="1.5"
                vector-effect="non-scaling-stroke"
                width={start.box.width}
                x={start.box.x}
                y={start.box.y}
              />
            </svg>
            <span
              class="parse-readout type-small absolute -translate-x-1/2 -translate-y-full pb-1 font-mono tabular-nums text-map-blue"
              data-readout="left"
              style={`left: ${readLeft.left}; top: ${readLeft.top}`}
            >{readLeft.text}</span>
            <span
              class="parse-readout type-small absolute -translate-y-1/2 pl-2 font-mono tabular-nums text-map-blue"
              data-readout="top"
              style={`left: ${readTop.left}; top: ${readTop.top}`}
            >{readTop.text}</span>
          </div>
        </figure>
        <div class="flex min-w-0 flex-col justify-center border-t border-rule px-5 py-7 sm:px-8 lg:border-t-0 lg:border-l">
          {PARSER_BOXES.map((parser, index) => {
            const [left, top] = parser.box;
            return (
              <div aria-labelledby={`parse-tab-${index}`} hidden={index !== 0} id={`parse-panel-${index}`} role="tabpanel">
                <p class="sr-only">
                  {parser.label} puts the box at {left.toFixed(3)} from the left and {top.toFixed(3)} from the top of the page.
                </p>
                <Code code={parser.code} label={`${parser.label} parse`} size="sm" />
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-end">
      <a class="type-small inline-flex min-h-11 items-center gap-2 text-map-blue underline-offset-4 hover:underline" href="/docs/results">What parse returns <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  /* The box settles in once the guides reach it. */
  .parse-box {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 250ms var(--ease-out-quint),
      transform 250ms var(--ease-out-quint);
  }

  [data-parse-figure][data-reveal="waiting"] .parse-box {
    opacity: 0;
    transform: scale(0.96);
  }
</style>

<script>
  import { bindAll } from "../../lib/bind";
  import type { Box } from "../../lib/parse-figure";
  import { boxGeometry, PARSER_BOXES, readouts } from "../../lib/parse-figure";
  import { onReveal, reducedMotion } from "../../lib/reveal";

  interface State {
    box: Box;
    /** How far the guides have reached from the page edges, 0 to 1. */
    reach: number;
  }

  // easings.net's easeOutQuint and easeInOutQuart, the curves behind the
  // --ease-out-quint and --ease-in-out-quart tokens.
  const outQuint = (p: number) => 1 - (1 - p) ** 5;
  const inOutQuart = (p: number) => (p < 0.5 ? 8 * p ** 4 : 1 - (-2 * p + 2) ** 4 / 2);

  const lerp = (from: number, to: number, p: number) => from + (to - from) * p;

  const set = (element: Element, values: Record<string, number>) => {
    for (const [name, value] of Object.entries(values)) {
      element.setAttribute(name, String(value));
    }
  };

  const need = <T extends Element>(root: Element, selector: string): T => {
    const element = root.querySelector<T>(selector);
    if (element === null) {
      throw new Error(`the parse figure is missing ${selector}`);
    }
    return element;
  };

  bindAll("[data-parse-figure]", (figure) => {
    const tabs = figure.closest<HTMLElement>("[data-provider-tabs]");
    const box = need<SVGRectElement>(figure, "[data-box]");
    const guideLeft = need<SVGLineElement>(figure, '[data-guide="left"]');
    const guideTop = need<SVGLineElement>(figure, '[data-guide="top"]');
    const readLeft = need<HTMLElement>(figure, '[data-readout="left"]');
    const readTop = need<HTMLElement>(figure, '[data-readout="top"]');
    const [first] = PARSER_BOXES;
    if (tabs === null || first === undefined) {
      throw new Error("the parse figure needs its tabs and boxes");
    }
    const start = first.box;

    let state: State = { box: start, reach: 1 };
    let goal = start;
    let frame = 0;

    const render = ({ box: current, reach }: State) => {
      const geometry = boxGeometry(current, reach);
      set(box, geometry.box);
      set(guideLeft, geometry.guideLeft);
      set(guideTop, geometry.guideTop);
      const shown = String(Math.min(1, reach * 3));
      const read = readouts(current, reach);
      for (const [element, values] of [
        [readLeft, read.left],
        [readTop, read.top],
      ] as const) {
        element.style.left = values.left;
        element.style.top = values.top;
        element.style.opacity = shown;
        element.textContent = values.text;
      }
    };

    // Moves from whatever is on screen, so a second click retargets mid-flight.
    const tween = (to: State, duration: number, ease: (p: number) => number) => {
      cancelAnimationFrame(frame);
      if (reducedMotion()) {
        state = to;
        render(state);
        return;
      }
      const from = state;
      const began = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - began) / duration);
        const e = ease(p);
        const [left, top, width, height] = from.box;
        const [toLeft, toTop, toWidth, toHeight] = to.box;
        state = {
          box: [lerp(left, toLeft, e), lerp(top, toTop, e), lerp(width, toWidth, e), lerp(height, toHeight, e)],
          reach: lerp(from.reach, to.reach, e),
        };
        render(state);
        if (state.reach > 0.85) {
          figure.dataset.reveal = "shown";
        }
        if (p < 1) {
          frame = requestAnimationFrame(step);
        }
      };
      frame = requestAnimationFrame(step);
    };

    const buttons = [...tabs.querySelectorAll('[role="tab"]')];
    tabs.addEventListener("tabchange", () => {
      const selected = buttons.findIndex((button) => button.getAttribute("aria-selected") === "true");
      const next = PARSER_BOXES[selected];
      if (next === undefined) {
        throw new Error("the parse figure has no parser for the selected tab");
      }
      goal = next.box;
      tween({ box: goal, reach: 1 }, 600, inOutQuart);
    });

    // The first time the figure comes into view, the guides draw in from the
    // page edges and the readouts count up to where the box sits. With
    // reduced motion it never waits: the box sits at its final state.
    const waiting = onReveal(figure, () => {
      tween({ box: goal, reach: 1 }, 1100, outQuint);
    });
    if (waiting) {
      state = { box: start, reach: 0 };
      figure.dataset.reveal = "waiting";
      render(state);
    }
  });
</script>
