---
import { RESUME_SAMPLE } from "../../lib/samples";
import Panel from "./panel.astro";
---

<section class="border-t border-rule">
  <div class="home-wrap flex flex-col gap-10 py-16 md:py-[120px] lg:flex-row lg:items-center lg:justify-between lg:gap-16">
    <div class="flex flex-col gap-6 lg:w-[520px] lg:shrink-0">
      <h2 class="type-heading md:max-w-[460px]">Collect a long job after a timeout.</h2>
      <p class="type-lead text-graphite">
        Pass the job's id back as <code class="font-mono text-ink">resume</code> instead of paying twice.
      </p>
      <a class="type-small inline-flex min-h-11 items-center self-start font-medium text-map-blue underline-offset-4 hover:underline" href="/docs/long-jobs">How long jobs work →</a>
    </div>
    <Panel caption="Exa" class="lg:w-[664px] lg:shrink" code={RESUME_SAMPLE} file="resume.ts" />
  </div>
</section>
