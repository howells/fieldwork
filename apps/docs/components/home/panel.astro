---
// A code panel with a header strip: a provider or caption on the left and a
// file name on the right. "dark" is an ink panel; "light" a paper card.
import Code from "./code.astro";

interface Props {
  code: string;
  caption?: string;
  file: string;
  tone?: "dark" | "light";
  class?: string;
}

const { caption, class: className, code, file, tone = "dark" } = Astro.props;
const dark = tone === "dark";
---

<figure
  class:list={[
    "m-0 min-w-0 overflow-clip rounded-[12px]",
    dark ? "bg-ink" : "hero-panel border border-rule bg-paper",
    className,
  ]}
>
  <figcaption
    class:list={[
      "flex h-[52px] items-center justify-between border-b px-5",
      dark ? "border-[#2A2D32]" : "border-rule bg-wash",
    ]}
  >
    <span class:list={["type-small", dark ? "text-[#A9ADB3]" : "text-graphite"]}>{caption}</span>
    <span class:list={["type-small font-mono", dark ? "text-[#9298A1]" : "text-graphite"]}>{file}</span>
  </figcaption>
  <div class="px-6 pt-6 pb-7">
    <Code code={code} tone={tone} />
  </div>
</figure>
