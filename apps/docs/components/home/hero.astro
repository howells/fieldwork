---
import { CAPABILITY_ROWS, PROVIDERS } from "../../lib/capabilities";
import { HERO_SAMPLES } from "../../lib/samples";
import Code from "./code.astro";
import Contours from "./contours.astro";
import InstallCommand from "./install-command.astro";
import TabList from "./tab-list.astro";

const STATS = [
  { label: "Providers", value: PROVIDERS.length },
  { label: "Capabilities", value: CAPABILITY_ROWS.length },
  { label: "Dependency", value: 1 },
  { label: "Error type", value: 1 },
];

const initial = HERO_SAMPLES.findIndex((sample) => sample.label === "Firecrawl");
---

<section class="relative overflow-clip">
  <Contours class="top-[-30px] left-[37.5%] hidden md:block" />
  <div class="home-wrap relative pt-12 pb-14 md:pt-[104px] md:pb-24">
    <a
      class="type-small group inline-flex min-h-11 items-center gap-2.5"
      href="/docs/errors#retries"
    >
      <span class="font-medium text-map-blue">0.4</span>
      <span class="text-graphite group-hover:text-ink">Failed requests now retry by default</span>
      <span aria-hidden="true" class="text-ink transition-transform group-hover:translate-x-0.5">→</span>
    </a>
    <h1 class="type-display mt-6 max-w-[1180px] text-ink md:mt-7">
      Search, read and research the web through one API.
    </h1>

    <div class="mt-8 flex flex-col gap-12 md:mt-[52px] lg:flex-row lg:items-start lg:justify-between lg:gap-14">
      <div class="flex flex-col gap-8 pt-2 lg:w-[520px] lg:shrink-0 lg:gap-10">
        <p class="type-lead text-graphite">
          Ten providers behind the same methods.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <InstallCommand />
          <a
            class="type-small inline-flex h-12 items-center justify-center rounded-[6px] border border-rule bg-paper px-[18px] font-medium text-ink transition-colors hover:border-[#c9cbc6]"
            href="/docs"
          >Read the docs</a>
        </div>
        <dl class="grid grid-cols-2 gap-y-6 border-t border-rule pt-6 sm:grid-cols-4">
          {STATS.map((stat) => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="type-small text-graphite">{stat.label}</dt>
              <dd class="type-heading m-0 text-ink">{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hero-panel min-w-0 overflow-clip rounded-[12px] border border-rule bg-paper lg:w-[672px] lg:shrink" data-provider-tabs>
        <TabList id="hero" initial={initial} label="Provider" tabs={HERO_SAMPLES.map((sample) => sample.label)} />
        {HERO_SAMPLES.map((sample, index) => (
          <div
            aria-labelledby={`hero-tab-${index}`}
            class="py-6 pr-7 pl-5"
            hidden={index !== initial}
            id={`hero-panel-${index}`}
            role="tabpanel"
          >
            <Code code={sample.code} numbered />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
