---
import GuideLayout from "../components/guide/guide-layout.astro";
import TaskMatrix from "../components/guide/task-matrix.astro";
---

<GuideLayout lead="Find sources, read pages, extract facts and compare evidence." section="matrix" title="Choose the right tool for the job.">
  <TaskMatrix />
</GuideLayout>

<script>
  // Keep links to sections of the original single-page guide working.
  const followLegacyHash = () => {
    if (location.pathname.replace(/\/$/u, "") !== "/tool-guide") {
      return;
    }
    const { hash } = location;
    if (hash === "#how-to-choose") {
      location.replace(`/tool-guide/choosing${hash}`);
    } else if (hash === "#tests-and-sources" || hash === "#studies" || hash.startsWith("#evidence-")) {
      location.replace(`/tool-guide/evidence${hash}`);
    }
  };
  followLegacyHash();
  document.addEventListener("astro:page-load", followLegacyHash);
  window.addEventListener("hashchange", followLegacyHash);
</script>
