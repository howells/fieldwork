---
import { GUIDE_PROVIDERS, GUIDE_TASKS, TASK_GROUPS } from "../../lib/tool-guide";
---

<section aria-labelledby="matrix-heading" data-guide-matrix id="matrix">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="type-title" id="matrix-heading">Find your task</h2>
    <p aria-live="polite" class="type-small m-0 text-graphite" data-task-count role="status">{GUIDE_TASKS.length} tasks</p>
  </div>

  <div class="mt-6 flex flex-col gap-3">
    <div class="grid gap-3 sm:grid-cols-[1fr_220px]">
      <label class="sr-only" for="task-search">Search tasks</label>
      <input class="type-small guide-input" data-task-search id="task-search" placeholder="Search tasks" type="search" />
      <label class="sr-only" for="task-provider">Starting provider</label>
      <select class="type-small guide-input" data-task-provider id="task-provider">
        <option value="">All providers</option>
        {GUIDE_PROVIDERS.map((provider) => <option value={provider}>{provider}</option>)}
      </select>
    </div>
    <div aria-label="Task type" class="-mx-1 flex gap-1 overflow-x-auto px-1 pb-1" role="group">
      {TASK_GROUPS.map((group) => (
        <button aria-controls="task-list" aria-pressed={group.id === "all" ? "true" : "false"} class="type-small guide-filter shrink-0" data-task-group={group.id} type="button">{group.label}</button>
      ))}
    </div>
  </div>

  <div class="mt-6 border-t border-ink" id="task-list">
    {GUIDE_TASKS.map((task) => (
        <details class="guide-task border-b border-rule" data-group={task.group} data-providers={task.providers.join("|")} data-task-row id={`task-${task.id}`}>
          <summary class="guide-task-summary">
            <span class="type-body font-medium text-ink">{task.title}</span>
            <span class="type-small font-mono text-map-blue">{task.capabilities.join(" · ")}</span>
            <span class="type-small text-ink">{task.choices.join(", ")}</span>
            <svg aria-hidden="true" class="disclosure-chevron" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 16 16" width="16"><path d="m4 6 4 4 4-4" /></svg>
          </summary>
          <div class="guide-task-detail">
            <p class="type-small m-0 max-w-2xl text-graphite">{task.why}</p>
            <a class="type-small guide-text-link" href={task.docs}>Read the docs →</a>
          </div>
        </details>
    ))}
  </div>
  <div class="border-b border-rule py-12 text-center" data-no-tasks hidden>
    <p class="type-small m-0 text-graphite">No tasks match these filters.</p>
    <button class="type-small guide-text-link mt-3" data-clear-filters type="button">Clear filters</button>
  </div>
</section>

<script>
  const matchesTask = (row: HTMLDetailsElement, group: string, query: string, provider: string) => {
    const matchesGroup = group === "all" || row.dataset.group === group;
    const matchesProvider = provider === "" || (row.dataset.providers ?? "").split("|").includes(provider);
    const matchesQuery = (row.textContent ?? "").toLowerCase().includes(query);
    return matchesGroup && matchesProvider && matchesQuery;
  };

  const bindRoot = (root: HTMLElement) => {
    const search = root.querySelector<HTMLInputElement>("[data-task-search]");
    const provider = root.querySelector<HTMLSelectElement>("[data-task-provider]");
    const count = root.querySelector<HTMLElement>("[data-task-count]");
    const empty = root.querySelector<HTMLElement>("[data-no-tasks]");
    if (!search || !provider || !count || !empty) {
      return;
    }
    root.dataset.bound = "";
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-task-group]")];
    const rows = [...root.querySelectorAll<HTMLDetailsElement>("[data-task-row]")];
    let group = "all";
    const update = () => {
      let visible = 0;
      for (const row of rows) {
        row.hidden = !matchesTask(row, group, search.value.trim().toLowerCase(), provider.value);
        if (!row.hidden) {
          visible += 1;
        }
      }
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.taskGroup === group));
      }
      count.textContent = `${visible} ${visible === 1 ? "task" : "tasks"}`;
      empty.hidden = visible !== 0;
    };
    search.addEventListener("input", update);
    provider.addEventListener("change", update);
    root.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }
      const button = event.target.closest<HTMLButtonElement>("[data-task-group]");
      if (button) {
        group = button.dataset.taskGroup ?? "all";
        update();
      }
      if (event.target.closest("[data-clear-filters]")) {
        search.value = "";
        provider.value = "";
        group = "all";
        update();
        search.focus();
      }
    });
    update();
  };

  const bindMatrix = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-guide-matrix]:not([data-bound])")) {
      bindRoot(root);
    }
  };
  bindMatrix();
  document.addEventListener("astro:page-load", bindMatrix);
</script>

<style>
  .guide-input { min-height: 44px; width: 100%; border: 1px solid var(--color-rule); border-radius: 6px; background: var(--color-paper); padding: 10px 14px; color: var(--color-ink); }
  .guide-input::placeholder { color: var(--color-graphite); }
  .guide-filter { min-height: 44px; padding: 10px 14px; border-radius: 6px; background: transparent; color: var(--color-graphite); cursor: pointer; }
  .guide-filter[aria-pressed="true"], .guide-filter:hover { background: var(--color-wash); color: var(--color-ink); }
  .guide-task-summary { display: grid; grid-template-columns: minmax(0, 1fr) 16px; align-items: center; gap: 4px 16px; min-height: 64px; padding-block: 16px; cursor: pointer; list-style: none; }
  .guide-task-summary::-webkit-details-marker { display: none; }
  .guide-task-summary > :nth-child(1) { grid-column: 1; }
  .guide-task-summary > :nth-child(2), .guide-task-summary > :nth-child(3) { grid-column: 1; }
  .guide-task-summary > .disclosure-chevron { grid-column: 2; grid-row: 1 / span 3; }
  .guide-task-summary:hover > :first-child { text-decoration: underline; text-underline-offset: 4px; }
  .guide-task-detail { padding: 0 0 16px; }
  [data-task-row][hidden], [data-no-tasks][hidden] { display: none; }
  [data-task-row] { scroll-margin-top: 96px; }
  @media (min-width: 1024px) {
    .guide-task-summary { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.5fr) 16px; gap: 24px; }
    .guide-task-summary > :nth-child(2) { grid-column: 2; }
    .guide-task-summary > :nth-child(3) { grid-column: 3; }
    .guide-task-summary > .disclosure-chevron { grid-column: 4; grid-row: 1; }
  }
</style>
