---
import { ACCESS_CASES, CHOOSING_COPY, GUIDE_RULES } from "../../lib/tool-guide";
---

<section aria-label="Choosing rules" id="how-to-choose">
  <a class="guide-text-link mb-8" href={CHOOSING_COPY.routerLink.href}>{CHOOSING_COPY.routerLink.label} <span aria-hidden="true">↗</span></a>
  <ol class="m-0 list-none border-t border-rule p-0">
    {GUIDE_RULES.map((rule, index) => (
      <li class="grid grid-cols-[32px_1fr] gap-x-4 gap-y-3 border-b border-rule py-7 md:grid-cols-[48px_1fr_1.1fr] md:gap-x-8 md:py-8">
        <span class="pt-1 text-sm text-graphite tabular-nums">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <h2 class="m-0 font-sans text-lg font-medium text-ink">{rule.title}</h2>
          <p class="mt-2 mb-0 text-sm leading-relaxed text-graphite">{rule.question}</p>
        </div>
        <p class="col-start-2 m-0 max-w-xl text-sm leading-relaxed text-graphite md:col-start-auto">{rule.detail}</p>
      </li>
    ))}
  </ol>
  <div class="mt-16 md:mt-24">
    <h2 class="guide-subheading">{CHOOSING_COPY.accessTitle}</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-graphite">{CHOOSING_COPY.accessLead}</p>
    <div class="mt-8 grid border-t border-rule sm:grid-cols-2">
      {ACCESS_CASES.map((item, index) => (
        <div class:list={["border-b border-rule py-7 sm:p-8", { "sm:border-r": index % 2 === 0 }]}>
          <p class="m-0 text-sm text-graphite">{item.label}</p>
          <h3 class="mt-4 mb-0 text-lg font-medium text-ink">{item.title}</h3>
          <p class="mt-3 mb-5 max-w-md text-sm leading-relaxed text-graphite">{item.detail}</p>
          <code class="text-sm text-map-blue">{item.capabilities}</code>
        </div>
      ))}
    </div>
  </div>
  <p class="mt-8 mb-0 max-w-3xl text-sm leading-relaxed text-graphite">{CHOOSING_COPY.note}</p>
</section>
