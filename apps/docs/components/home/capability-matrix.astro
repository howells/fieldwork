---
import { CAPABILITY_ROWS, PROVIDERS } from "../../lib/capabilities";
---

<section class="border-t border-rule">
  <div class="home-wrap py-16 md:py-[120px]">
    <h2 class="type-heading md:max-w-[520px]">Change the provider.<br />Keep every call.</h2>

    <table class="mt-10 hidden w-full border-collapse text-left md:mt-16 lg:table">
      <caption class="sr-only">Which capabilities each provider offers</caption>
      <thead>
        <tr class="border-b border-ink">
          <th class="type-small pb-4 text-graphite" scope="col">Method</th>
          <th class="pb-4" scope="col"><span class="sr-only">What it does</span></th>
          {PROVIDERS.map((provider) => (
            <th class="type-small w-[100px] pb-4 text-center font-medium text-ink" scope="col">{provider.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {CAPABILITY_ROWS.map((row) => (
          <tr class="border-b border-rule">
            <th class="type-small h-[52px] w-[116px] font-mono text-ink" scope="row">{row.name}</th>
            <td class="type-small text-graphite">{row.summary}</td>
            {PROVIDERS.map((provider) => (
              <td class="text-center">
                {provider.supports[row.name] ? (
                  <span class="inline-block size-[7px] rounded-full bg-map-blue"><span class="sr-only">Yes</span></span>
                ) : (
                  <span class="inline-block h-px w-3 bg-rule align-middle"><span class="sr-only">No</span></span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>

    <dl class="mt-8 lg:hidden">
      {CAPABILITY_ROWS.map((row) => (
        <div class="flex flex-col gap-1 border-b border-rule py-3.5">
          <dt class="type-small font-mono text-ink">{row.name}</dt>
          <dd class="type-small m-0 text-graphite">
            {row.providers.length === PROVIDERS.length ? "All eight" : row.providers.join(", ")}
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-8 flex justify-end">
      <a class="type-small inline-flex min-h-11 items-center gap-2 text-map-blue underline-offset-4 hover:underline" href="/tools">Which provider for which task <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
