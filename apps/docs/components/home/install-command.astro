---
const command = "npm i @howells/fieldwork-sdk";
---

<button
  class="install-command group inline-flex h-12 items-center gap-3 rounded-[6px] bg-ink px-[18px] font-mono text-[14px] text-paper transition-colors hover:bg-[#23262b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-map-blue"
  data-command={command}
  data-install-command
  type="button"
>
  <span aria-hidden="true" class="text-[#A9ADB3]">$</span>
  <span>{command}</span>
  <span class="relative size-4 shrink-0 text-[#A9ADB3]">
    <svg aria-hidden="true" class="copy-icon absolute inset-0" fill="none" height="16" viewBox="0 0 16 16" width="16">
      <rect height="8" rx="1.5" stroke="currentColor" stroke-width="1.3" width="8" x="5" y="5"></rect>
      <path d="M3 10.5V4a1 1 0 0 1 1-1h6.5" stroke="currentColor" stroke-width="1.3"></path>
    </svg>
    <svg aria-hidden="true" class="check-icon absolute inset-0" fill="none" height="16" viewBox="0 0 16 16" width="16">
      <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
    </svg>
  </span>
  <span class="sr-only" data-install-status>Copy the install command</span>
</button>

<script>
  const bind = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      "[data-install-command]:not([data-bound])"
    )) {
      button.dataset.bound = "";
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.command ?? "");
        const status = button.querySelector("[data-install-status]");
        button.dataset.copied = "";
        if (status) {
          status.textContent = "Copied";
        }
        setTimeout(() => {
          delete button.dataset.copied;
          if (status) {
            status.textContent = "Copy the install command";
          }
        }, 1600);
      });
    }
  };

  bind();
  document.addEventListener("astro:page-load", bind);
</script>
