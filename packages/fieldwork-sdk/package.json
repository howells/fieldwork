{
  "name": "@howells/fieldwork-sdk",
  "version": "0.6.1",
  "description": "One API for web search, page reading, extraction, crawling, answers, research, browser sessions, monitoring and document parsing across Exa, Firecrawl, Tavily, Parallel, Perplexity, Brave, SerpApi, Browserbase, Kernel, LlamaParse and Reducto.",
  "keywords": [
    "agents",
    "brave",
    "browserbase",
    "document-parsing",
    "exa",
    "extraction",
    "firecrawl",
    "kernel",
    "llamaparse",
    "monitoring",
    "parallel",
    "pdf",
    "perplexity",
    "reducto",
    "research",
    "scraping",
    "sdk",
    "serpapi",
    "tavily",
    "web-search"
  ],
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/fieldwork.git",
    "directory": "packages/fieldwork-sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./exa": {
      "types": "./dist/exa.d.ts",
      "import": "./dist/exa.js"
    },
    "./firecrawl": {
      "types": "./dist/firecrawl.d.ts",
      "import": "./dist/firecrawl.js"
    },
    "./tavily": {
      "types": "./dist/tavily.d.ts",
      "import": "./dist/tavily.js"
    },
    "./parallel": {
      "types": "./dist/parallel.d.ts",
      "import": "./dist/parallel.js"
    },
    "./perplexity": {
      "types": "./dist/perplexity.d.ts",
      "import": "./dist/perplexity.js"
    },
    "./brave": {
      "types": "./dist/brave.d.ts",
      "import": "./dist/brave.js"
    },
    "./serpapi": {
      "types": "./dist/serpapi.d.ts",
      "import": "./dist/serpapi.js"
    },
    "./browserbase": {
      "types": "./dist/browserbase.d.ts",
      "import": "./dist/browserbase.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js"
    },
    "./llamaparse": {
      "types": "./dist/llamaparse.d.ts",
      "import": "./dist/llamaparse.js"
    },
    "./reducto": {
      "types": "./dist/reducto.d.ts",
      "import": "./dist/reducto.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "turndown": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@howells/lint": "catalog:",
    "@howells/typescript-config": "catalog:",
    "@types/node": "catalog:",
    "@types/turndown": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
